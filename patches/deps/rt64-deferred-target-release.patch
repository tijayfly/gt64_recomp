+            decltype(RenderTarget::filterDescSet) filterDescSet;
+            decltype(RenderTarget::fbWriteDescSet) fbWriteDescSet;
+            std::chrono::steady_clock::time_point released;
+        };
+
+        std::mutex releasedMutex;
+
+        // (Never destroyed: at exit the device may already be gone.)
+        std::deque<std::unique_ptr<ReleasedTextures>> &releasedTextures() {
+            static auto *released = new std::deque<std::unique_ptr<ReleasedTextures>>();
+            return *released;
+        }
