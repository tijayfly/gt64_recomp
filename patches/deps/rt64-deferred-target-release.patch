+    // GT64: a target's textures are kept for a while after it is resized or destroyed instead of going at once. The
+    // present thread draws the in-between frames from the interpolated targets without the workload lock, and the
+    // workload thread stops waiting for it after a while (to avoid a deadlock); a target it then resized under the
+    // present thread was destroyed while the present thread made a descriptor for it (a crash in the driver, in
+    // VIRenderer::render, leaving qualifying or a race). Kept two seconds, then destroyed by the next release.
+    namespace {
+        struct ReleasedTextures {
+            // (Destroyed in the reverse order: descriptor sets, then framebuffers and views, then the textures.)
+            std::unique_ptr<RenderTexture> texture;
+            std::unique_ptr<RenderTexture> resolvedTexture;
+            std::unique_ptr<RenderTexture> downsampledTexture;
+            std::unique_ptr<RenderTexture> dummyTexture;
