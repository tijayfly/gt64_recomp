+    // GT64 draw distance: move a loaded perspective projection's far plane out by getFarScale() (z column only, so x, y
+    // and w are untouched) and note how z / w changes for the fog. Returns false for anything that isn't a plain
+    // perspective projection (z = m22 * z + m32 * w, w = -z).
+    static bool extendFarPlane(const hlslpp::float4x4 &m, float scale, hlslpp::float4x4 &out, float &fogK, float &fogC) {
+        const float m02 = m[0][2], m12 = m[1][2], m22 = m[2][2], m32 = m[3][2];
+        const float m23 = m[2][3], m33 = m[3][3];
+        if ((m02 != 0.0f) || (m12 != 0.0f) || (m23 != -1.0f) || (m33 != 0.0f) || (m22 >= -1.0f) || (m32 >= 0.0f)) {
+            return false;
+        }
+
+        const float n = m32 / (m22 - 1.0f);
+        const float f = m32 / (m22 + 1.0f);
+        if (!(n > 0.0f) || !(f > n)) {
+            return false;
+        }
+
+        const float f2 = f * scale;
+        const float m22b = (n + f2) / (n - f2);
+        const float m32b = (2.0f * n * f2) / (n - f2);
+        // ndc = -m22 + m32 / d, so the original ndc is a linear function of the new one.
+        fogK = m32 / m32b;
+        fogC = -m22 + m22b * fogK;
+        out = hlslpp::float4x4(
+            hlslpp::float4(m[0][0], m[0][1], m02, m[0][3]),
+            hlslpp::float4(m[1][0], m[1][1], m12, m[1][3]),
+            hlslpp::float4(m[2][0], m[2][1], m22b, m23),
+            hlslpp::float4(m[3][0], m[3][1], m32b, m33));
+        return true;
+    }
