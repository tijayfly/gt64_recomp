+            // the window so the fade covers the whole screen in widescreen.
+            const bool fadeTile = (mode == ObjDrawMode::Rectangle) && (texW == 64) && (texH == 32) &&
+                (s.imageFmt == G_IM_FMT_CI) && (s.imageSiz == G_IM_SIZ_4b);
+            const uint8_t savedAspect = rdp->extended.global.rectAspect;
+            if (fadeTile) {
+                rdp->extended.global.rectAspect = G_EX_ASPECT_STRETCH;
+            }
+            state->startSpriteCommand(0);
+            rdp->drawTexRect(ulxQ, ulyQ, lrxQ, lryQ, G_TX_RENDERTILE, uls, ult, int16_t(dsdx), int16_t(dtdy), false);
+            state->endSpriteCommand();
+            rdp->extended.global.rectAspect = savedAspect;
+        }
