+        // S2DEX 1.x object drawing (G_OBJ_MOVEMEM, G_OBJ_RECTANGLE, G_OBJ_SPRITE and the drawing half of the
+        // G_OBJ_LDTX_* commands), drawn as texture rectangles. Sprites with rotation (B/C in the 2D matrix) are drawn
+        // with the matrix's scale only.
+
+        // The 2D matrix in DMEM: A, B, C, D (s15.16), X, Y (s10.2), BaseScaleX, BaseScaleY (u5.10).
+        static std::array<uint8_t, 24> objMtxBuffer = {
+            // Identity, as the microcode initializes it (stored in RDRAM word order).
+            0x00, 0x00, 0x01, 0x00,  0x00, 0x00, 0x00, 0x00,  0x00, 0x00, 0x00, 0x00,  0x00, 0x00, 0x01, 0x00,
+            0x00, 0x00, 0x00, 0x00,  0x00, 0x04, 0x00, 0x04,
+        };
+
+        static uint32_t bufWord(const uint8_t *buf, uint32_t offset) {
+            uint32_t w;
+            memcpy(&w, buf + offset, sizeof(w));
+            return w;
+        }
+
+        struct ObjSpriteFields {
+            int16_t objX; uint16_t scaleW; uint16_t imageW;
+            int16_t objY; uint16_t scaleH; uint16_t imageH;
+            uint16_t imageStride; uint16_t imageAdrs;
+            uint8_t imageFmt; uint8_t imageSiz; uint8_t imagePal; uint8_t imageFlags;
+        };
+
+        // uObjSprite (24 bytes) from a buffer in RDRAM word order.
+        static ObjSpriteFields readObjSprite(const uint8_t *buf) {
+            ObjSpriteFields s;
+            uint32_t w0 = bufWord(buf, 0), w1 = bufWord(buf, 4), w2 = bufWord(buf, 8), w3 = bufWord(buf, 12);
+            uint32_t w4 = bufWord(buf, 16), w5 = bufWord(buf, 20);
+            s.objX = int16_t(w0 >> 16); s.scaleW = uint16_t(w0); s.imageW = uint16_t(w1 >> 16);
+            s.objY = int16_t(w2 >> 16); s.scaleH = uint16_t(w2); s.imageH = uint16_t(w3 >> 16);
+            s.imageStride = uint16_t(w4 >> 16); s.imageAdrs = uint16_t(w4);
+            s.imageFmt = uint8_t(w5 >> 24); s.imageSiz = uint8_t(w5 >> 16); s.imagePal = uint8_t(w5 >> 8); s.imageFlags = uint8_t(w5);
+            return s;
+        }
+
+        enum class ObjDrawMode { Rectangle, RectangleR, Sprite };
+
+        static void drawObj(State *state, const uint8_t *spriteBuf, ObjDrawMode mode) {
+            RDP *rdp = state->rdp.get();
+            RSP *rsp = state->rsp.get();
+            const ObjSpriteFields s = readObjSprite(spriteBuf);
+            if ((s.scaleW == 0) || (s.scaleH == 0) || (s.imageW < 32) || (s.imageH < 32)) {
+                return;
+            }
+
+            // Texture: the image is already in TMEM (loaded by G_OBJ_LOADTXTR or the LDTX command).
+            const bool clamp = (rsp->objRenderMode & S2DEX_G_OBJRM_NOTXCLAMP) == 0;
+            const uint8_t cm = clamp ? G_TX_CLAMP : G_TX_WRAP;
+            const uint16_t texW = s.imageW >> 5;
+            const uint16_t texH = s.imageH >> 5;
+            rdp->setTile(G_TX_RENDERTILE, s.imageFmt, s.imageSiz, s.imageStride, s.imageAdrs, s.imagePal & 0xF, cm, cm, 0, 0, 0, 0);
+            rdp->setTileSize(G_TX_RENDERTILE, 0, 0, uint16_t((texW - 1) << 2), uint16_t((texH - 1) << 2));
+
+            // Screen rectangle in 10.2 and texel steps in 5.10.
+            double ulx = s.objX / 4.0, uly = s.objY / 4.0;
+            double scaleX = s.scaleW / 1024.0, scaleY = s.scaleH / 1024.0;
+            if (mode != ObjDrawMode::Rectangle) {
+                const uint8_t *m = objMtxBuffer.data();
+                const uint32_t xy = bufWord(m, 16), base = bufWord(m, 20);
+                const double mtxX = int16_t(xy >> 16) / 4.0, mtxY = int16_t(xy) / 4.0;
+                double baseX = uint16_t(base >> 16) / 1024.0, baseY = uint16_t(base) / 1024.0;
+                if (baseX <= 0.0) baseX = 1.0;
+                if (baseY <= 0.0) baseY = 1.0;
+                if (mode == ObjDrawMode::Sprite) {
+                    // x' = A * x + X, y' = D * y + Y (rotation terms ignored).
+                    const double a = int32_t(bufWord(m, 0)) / 65536.0, d = int32_t(bufWord(m, 12)) / 65536.0;
+                    baseX = (a != 0.0) ? 1.0 / a : 1.0;
+                    baseY = (d != 0.0) ? 1.0 / d : 1.0;
+                }
+                ulx = ulx / baseX + mtxX;
+                uly = uly / baseY + mtxY;
+                scaleX *= baseX;
+                scaleY *= baseY;
+            }
+
+            const double frameW = texW / scaleX, frameH = texH / scaleY;
+            int32_t ulxQ = int32_t(ulx * 4.0), ulyQ = int32_t(uly * 4.0);
+            int32_t lrxQ = int32_t((ulx + frameW) * 4.0), lryQ = int32_t((uly + frameH) * 4.0);
+            int32_t dsdx = int32_t(scaleX * 1024.0), dtdy = int32_t(scaleY * 1024.0);
+            int16_t uls = 0, ult = 0;
+            if (s.imageFlags & 0x01) { uls = int16_t((texW - 1) << 5); dsdx = -dsdx; }
+            if (s.imageFlags & 0x10) { ult = int16_t((texH - 1) << 5); dtdy = -dtdy; }
+
+            // Copy mode: the RDP steps 4 texels per dsdx unit and the lower right edge is inclusive.
+            if (rdp->otherMode.cycleType() == G_CYC_COPY) {
+                dsdx *= 4;
+                lrxQ -= 4;
+                lryQ -= 4;
+            }
