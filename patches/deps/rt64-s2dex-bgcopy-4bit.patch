             assert(bg.imageLoad == S2DEX_G_BGLT_LOADTILE); // TODO: Only the load tile version is implemented.
             
             const uint16_t TMEMAddress = 0;
+
+            // 4-bit and 8-bit images: load them as 16-bit texels like the microcode does (the RDP can't load 4-bit
+            // images with LoadTile, and the line pitch below is only right for 16/32-bit), in bands that fit TMEM
+            // (half of it for CI images, the other half holds the palette), then sample with the real format.
+            if (bg.imageSiz < G_IM_SIZ_16b) {
+                const uint32_t imagePixW = bg.imageW >> 2;
+                const uint32_t imagePixH = bg.imageH >> 2;
+                const uint32_t lineBytes = (imagePixW << bg.imageSiz) >> 1;
+                const uint16_t line = static_cast<uint16_t>((lineBytes + 7) >> 3);
+                const uint32_t tmemBytes = (bg.imageFmt == G_IM_FMT_CI) ? 2048 : 4096;
+                const uint32_t bandLines = std::max<uint32_t>(tmemBytes / (uint32_t(line) << 3), 1);
+                const uint16_t loadLrs = static_cast<uint16_t>(((lineBytes >> 1) - 1) << 2);
+                const uint16_t renderLrs = static_cast<uint16_t>((imagePixW - 1) << 2);
+                rsp->setTextureImage(G_IM_FMT_RGBA, G_IM_SIZ_16b, lineBytes >> 1, state->rsp->fromSegmented(bg.imageAddress));
+                rdp->setTile(G_TX_LOADTILE, G_IM_FMT_RGBA, G_IM_SIZ_16b, line, TMEMAddress, 0, 0, 0, 0, 0, 0, 0);
+                rdp->setTile(G_TX_RENDERTILE, bg.imageFmt, bg.imageSiz, line, TMEMAddress, static_cast<uint8_t>(bg.imagePal), 0, 0, 0, 0, 0, 0);
+                state->startSpriteCommand(0);
+                for (uint32_t y = 0; y < imagePixH; y += bandLines) {
+                    const uint32_t lines = std::min(bandLines, imagePixH - y);
+                    const uint16_t lrt = static_cast<uint16_t>((lines - 1) << 2);
+                    rdp->loadTile(G_TX_LOADTILE, 0, static_cast<uint16_t>(y << 2), loadLrs, static_cast<uint16_t>((y + lines - 1) << 2));
+                    rdp->setTileSize(G_TX_RENDERTILE, 0, 0, renderLrs, lrt);
+                    const int32_t y0 = bg.frameY + int32_t(y << 2);
+                    rdp->drawTexRect(bg.frameX, y0, bg.frameX + bg.frameW - 4, y0 + lrt, G_TX_RENDERTILE, 0, 0, 4 << 10, 4 << 8, false);
+                }
+                state->endSpriteCommand();
+                return;
+            }
+
             const uint8_t lineShiftOffset = (bg.imageSiz == G_IM_SIZ_32b) ? 1 : 0;
             const uint16_t bgLine = bg.imageW >> (2 + bg.imageSiz - lineShiftOffset);
