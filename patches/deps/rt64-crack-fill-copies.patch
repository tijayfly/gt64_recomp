+    RenderTexture *FramebufferRenderer::crackFillCopyFor(RenderDevice *device, const RenderTarget *colorTarget) {
+        if (colorTarget == nullptr) {
+            return nullptr;
+        }
+
+        crackFillCopyUse++;
+        for (CrackFillCopy &copy : crackFillCopies) {
+            if ((copy.width == colorTarget->width) && (copy.height == colorTarget->height) && (copy.format == colorTarget->format) &&
+                (copy.samples == colorTarget->multisampling.sampleCount)) {
+                copy.lastUse = crackFillCopyUse;
+                return copy.texture.get();
+            }
+        }
+
+        // (Null device: only one that's there already.)
+        if (device == nullptr) {
+            return nullptr;
+        }
+
+        // Past four sizes, the one unused for longest goes.
+        if (crackFillCopies.size() >= 4) {
+            size_t oldest = 0;
+            for (size_t i = 1; i < crackFillCopies.size(); i++) {
+                if (crackFillCopies[i].lastUse < crackFillCopies[oldest].lastUse) {
+                    oldest = i;
+                }
+            }
+
+            retireTexture(std::move(crackFillCopies[oldest].texture));
+            crackFillCopies.erase(crackFillCopies.begin() + oldest);
+        }
+
+        CrackFillCopy copy;
+        copy.texture = device->createTexture(RenderTextureDesc::ColorTarget(colorTarget->width, colorTarget->height, colorTarget->format, colorTarget->multisampling));
+        copy.width = colorTarget->width;
+        copy.height = colorTarget->height;
+        copy.format = colorTarget->format;
+        copy.samples = colorTarget->multisampling.sampleCount;
+        copy.lastUse = crackFillCopyUse;
+        crackFillCopies.emplace_back(std::move(copy));
+        return crackFillCopies.back().texture.get();
+    }
+
+    void FramebufferRenderer::retireTexture(std::unique_ptr<RenderTexture> texture, std::unique_ptr<RenderTextureView> view) {
+        if (texture == nullptr) {
+            return;
+        }
+
+        retiredTextures.emplace_back(std::move(texture), std::move(view));
+        while (retiredTextures.size() > 8) {
+            // (The view before its texture.)
+            retiredTextures.front().second.reset();
+            retiredTextures.pop_front();
+        }
+    }
