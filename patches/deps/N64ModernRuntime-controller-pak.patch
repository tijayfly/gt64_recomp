+// osPfsInitPak(OSMesgQueue* mq, OSPfs* pfs, int channel)
+extern "C" void osPfsInitPak_recomp(uint8_t* rdram, recomp_context* ctx) {
+    struct LogOnExit { recomp_context* c; ~LogOnExit() { log_call("osPfsInitPak", int32_t(c->r2)); } } log_on_exit{ ctx };
+    std::lock_guard lock{ pak_mutex };
+    const gpr pfs_addr = ctx->r5;
+    const int channel = int(ctx->r6);
+    Pak* pak = get_pak(channel);
+    if (pak == nullptr) {
+        ctx->r2 = PFS_ERR_NOPACK;
+        return;
+    }
+    OSPfs* pfs = TO_PTR(OSPfs, pfs_addr);
+    pfs->status = 1; // PFS_INITIALIZED
+    pfs->queue = ctx->r4;
+    pfs->channel = channel;
+    pfs->version = 0;
+    pfs->dir_size = max_notes;
+    pfs->inode_table = 1 * 8;
+    pfs->minode_table = 2 * 8;
+    pfs->dir_table = 3 * 8;
+    pfs->inode_start_page = first_data_page;
+    pfs->banks = 1;
+    pfs->activebank = 0;
+    ctx->r2 = 0;
 }
 
