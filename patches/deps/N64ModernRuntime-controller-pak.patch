+// Controller Pak: a 32 KB pak image (the standard .mpk layout emulators use) kept in the saves folder, one per
+// controller, behind the libultra osPfs* calls.
+//
+// Layout (128 pages of 256 bytes): page 0 the ID area (32-byte ID blocks at 0x20, 0x60, 0x80, 0xC0), page 1 the inode
+// table (128 big-endian u16 entries: the next page of a file, 1 = last page, 3 = free; entry 0's low byte is the
+// checksum of entries 5..127), page 2 its backup, pages 3-4 the note table (16 notes of 32 bytes), pages 5-127 data.
+
+namespace {
+    constexpr int PFS_ERR_NOPACK = 1;
+    constexpr int PFS_ERR_INVALID = 5;
+    constexpr int PFS_DATA_FULL = 7;
+    constexpr int PFS_DIR_FULL = 8;
+    constexpr int PFS_ERR_EXIST = 9;
+
+    constexpr size_t pak_size = 0x8000;
+    constexpr size_t page_size = 0x100;
+    constexpr int pages = 128;
+    constexpr int first_data_page = 5;
+    constexpr int max_notes = 16;
+    constexpr uint16_t inode_last = 1;
+    constexpr uint16_t inode_free = 3;
+
+    struct Pak {
+        bool loaded = false;
+        std::array<uint8_t, pak_size> data{};
+    };
+    std::array<Pak, 4> paks;
+    std::mutex pak_mutex;
+
+    std::filesystem::path pak_path(int channel) {
+        std::filesystem::path folder = ultramodern::get_save_file_path().parent_path();
+        return folder / ("controller_pak_" + std::to_string(channel + 1) + ".mpk");
+    }
+
+    uint16_t be16(const uint8_t* p) { return uint16_t((p[0] << 8) | p[1]); }
+    void put16(uint8_t* p, uint16_t v) { p[0] = uint8_t(v >> 8); p[1] = uint8_t(v); }
+    uint32_t be32(const uint8_t* p) { return (uint32_t(p[0]) << 24) | (uint32_t(p[1]) << 16) | (uint32_t(p[2]) << 8) | p[3]; }
+    void put32(uint8_t* p, uint32_t v) { put16(p, uint16_t(v >> 16)); put16(p + 2, uint16_t(v)); }
+
+    uint16_t inode(const Pak& pak, int page) { return be16(&pak.data[page_size + page * 2]); }
+
+    void set_inode(Pak& pak, int page, uint16_t value) { put16(&pak.data[page_size + page * 2], value); }
+
+    // Checksum the inode table and copy it to its backup page.
+    void finish_inodes(Pak& pak) {
+        uint8_t sum = 0;
+        for (int i = first_data_page * 2; i < pages * 2; i++) {
+            sum += pak.data[page_size + i];
+        }
+        pak.data[page_size + 1] = sum;
+        std::memcpy(&pak.data[2 * page_size], &pak.data[page_size], page_size);
+    }
+
+    void format(Pak& pak) {
+        pak.data.fill(0);
+        // ID block: serial, device id 1, one bank, then the checksum of its first 14 words and 0xFFF2 minus it.
+        uint8_t id[32] = {};
+        put32(id + 4, 0x47543634); // "GT64" as the random/serial field
+        put16(id + 24, 0x0001);
+        id[26] = 1;  // banks
+        uint16_t sum = 0;
+        for (int i = 0; i < 28; i += 2) {
+            sum += be16(id + i);
+        }
+        put16(id + 28, sum);
+        put16(id + 30, uint16_t(0xFFF2 - sum));
+        for (size_t offset : { 0x20, 0x60, 0x80, 0xC0 }) {
+            std::memcpy(&pak.data[offset], id, sizeof(id));
+        }
+        for (int page = first_data_page; page < pages; page++) {
+            set_inode(pak, page, inode_free);
+        }
+        finish_inodes(pak);
+    }
+
+    void save(int channel) {
+        const std::filesystem::path path = pak_path(channel);
+        std::error_code ec;
+        std::filesystem::create_directories(path.parent_path(), ec);
+        {
+            std::ofstream out = recomp::open_output_file_with_backup(path, std::ios_base::binary);
+            if (!out.good()) {
+                return;
+            }
+            out.write(reinterpret_cast<const char*>(paks[channel].data.data()), pak_size);
+        }
+        recomp::finalize_output_file_with_backup(path);
+    }
 
-extern "C" void osPfsFreeBlocks_recomp(uint8_t * rdram, recomp_context * ctx) {
-    ctx->r2 = 1; // PFS_ERR_NOPACK
+    Pak* get_pak(int channel) {
+        if (channel < 0 || channel >= int(paks.size())) {
+            return nullptr;
+        }
+        Pak& pak = paks[channel];
+        if (!pak.loaded) {
+            std::ifstream in(pak_path(channel), std::ios_base::binary);
+            if (in.good() && in.read(reinterpret_cast<char*>(pak.data.data()), pak_size) && in.gcount() == std::streamsize(pak_size)) {
+                pak.loaded = true;
+            }
+            else {
+                format(pak);
+                pak.loaded = true;
+                save(channel);
+            }
+        }
+        return &pak;
+    }
+
+    uint8_t* note(Pak& pak, int file_no) { return &pak.data[3 * page_size + file_no * 32]; }
+    bool note_used(Pak& pak, int file_no) {
+        const uint8_t* n = note(pak, file_no);
+        return be32(n) != 0 || be16(n + 4) != 0;
+    }
+
+    int free_pages(const Pak& pak) {
+        int count = 0;
+        for (int page = first_data_page; page < pages; page++) {
+            count += (inode(pak, page) == inode_free);
+        }
+        return count;
+    }
+
+    int file_pages(const Pak& pak, int start) {
+        int count = 0;
+        for (int page = start; page >= first_data_page && page < pages && count < pages; page = inode(pak, page)) {
+            count++;
+            if (inode(pak, page) == inode_last) {
+                break;
+            }
+        }
+        return count;
+    }
+
+    // RDRAM helpers: the game's byte buffers and 16/32-bit values through the recompiler's address swizzling.
+    uint8_t rd8(uint8_t* rdram, gpr addr) { return MEM_BU(0, addr); }
+    void wr8(uint8_t* rdram, gpr addr, uint8_t v) { MEM_B(0, addr) = int8_t(v); }
+
+    int channel_of(uint8_t* rdram, gpr pfs_addr) {
+        return TO_PTR(OSPfs, pfs_addr)->channel;
+    }
+
+    bool names_match(uint8_t* rdram, const uint8_t* n, gpr game_name, gpr ext_name) {
+        for (int i = 0; i < 16; i++) {
+            if (n[16 + i] != rd8(rdram, game_name + i)) {
+                return false;
+            }
+        }
+        for (int i = 0; i < 4; i++) {
+            if (n[12 + i] != rd8(rdram, ext_name + i)) {
+                return false;
+            }
+        }
+        return true;
+    }
+
+    int find(uint8_t* rdram, Pak& pak, uint16_t company, uint32_t game, gpr game_name, gpr ext_name) {
+        for (int i = 0; i < max_notes; i++) {
+            const uint8_t* n = note(pak, i);
+            if (note_used(pak, i) && be32(n) == game && be16(n + 4) == company && names_match(rdram, n, game_name, ext_name)) {
+                return i;
+            }
+        }
+        return -1;
+    }
+
+    // GT_PAK_LOG: log each call.
+    void log_call(const char* name, int result) {
+#ifdef _WIN32
+        static const bool log = true;  // into GT64Recompiled.log
+#else
+        static const bool log = std::getenv("GT_PAK_LOG") != nullptr;
+#endif
+        if (log) {
+            std::fprintf(stderr, "[pak] %s -> %d\n", name, result);
+        }
+    }
+
+    gpr stack_arg(uint8_t* rdram, recomp_context* ctx, int index) {
+        return MEM_W(0x10 + (index - 4) * 4, ctx->r29);
+    }
 }
 
