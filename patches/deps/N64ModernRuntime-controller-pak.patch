+extern "C" void osPfsAllocateFile_recomp(uint8_t* rdram, recomp_context* ctx) {
+    struct LogOnExit { recomp_context* c; ~LogOnExit() { log_call("osPfsAllocateFile", int32_t(c->r2)); } } log_on_exit{ ctx };
+    std::lock_guard lock{ pak_mutex };
