+        return;
+    }
+    const uint16_t company = uint16_t(ctx->r5);
+    const uint32_t game = uint32_t(ctx->r6);
+    const gpr game_name = ctx->r7, ext_name = stack_arg(rdram, ctx, 4);
+    const int length = int32_t(stack_arg(rdram, ctx, 5));
+    const gpr file_no_out = stack_arg(rdram, ctx, 6);
+    if (company == 0 || game == 0 || length <= 0) {
+        ctx->r2 = PFS_ERR_INVALID;
+        return;
+    }
+    if (find(rdram, *pak, company, game, game_name, ext_name) >= 0) {
+        ctx->r2 = PFS_ERR_EXIST;
+        return;
+    }
+    int file_no = -1;
+    for (int i = 0; i < max_notes; i++) {
+        if (!note_used(*pak, i)) {
