+    // GT64: when the device is lost (every Map then returns null and the renderer's threads crash on it), why it was,
+    // to the log, once: the removal reason, and from DRED (enabled in D3D12Interface) the last commands the GPU had
+    // been given and the resources around a page fault.
+    static void reportDeviceRemoved(D3D12Device *device, const char *where, HRESULT res) {
+        static std::atomic<bool> reported = false;
+        if ((device == nullptr) || (device->d3d == nullptr) || reported.exchange(true)) {
+            return;
+        }
+
+        const HRESULT reason = device->d3d->GetDeviceRemovedReason();
+        fprintf(stderr, "[d3d12] %s failed with 0x%lX: device removed reason 0x%lX\n", where, res, reason);
+        ID3D12DeviceRemovedExtendedData1 *dred = nullptr;
+        if (SUCCEEDED(device->d3d->QueryInterface(IID_PPV_ARGS(&dred)))) {
+            D3D12_DRED_AUTO_BREADCRUMBS_OUTPUT1 crumbs = {};
+            if (SUCCEEDED(dred->GetAutoBreadcrumbsOutput1(&crumbs))) {
+                int lists = 0;
+                for (const D3D12_AUTO_BREADCRUMB_NODE1 *node = crumbs.pHeadAutoBreadcrumbNode; (node != nullptr) && (lists < 24); node = node->pNext) {
+                    const uint32_t done = (node->pLastBreadcrumbValue != nullptr) ? *node->pLastBreadcrumbValue : 0;
+                    if ((done == 0) || (done >= node->BreadcrumbCount)) {
+                        continue;
+                    }
+
+                    lists++;
+                    fprintf(stderr, "[d3d12]   list \"%ls\" queue \"%ls\": %u of %u commands done\n", node->pCommandListDebugNameW ? node->pCommandListDebugNameW : L"",
+                        node->pCommandQueueDebugNameW ? node->pCommandQueueDebugNameW : L"", done, node->BreadcrumbCount);
+                    const uint32_t from = (done > 12) ? (done - 12) : 0;
+                    const uint32_t to = (done + 4 < node->BreadcrumbCount) ? (done + 4) : node->BreadcrumbCount;
+                    for (uint32_t i = from; i < to; i++) {
+                        fprintf(stderr, "[d3d12]     %s#%u op %d\n", (i == done) ? "> " : "  ", i, int(node->pCommandHistory[i]));
+                    }
+                }
+
+                if (lists == 0) {
+                    fprintf(stderr, "[d3d12]   no command list was part way through\n");
+                }
+            }
+
+            D3D12_DRED_PAGE_FAULT_OUTPUT1 fault = {};
+            if (SUCCEEDED(dred->GetPageFaultAllocationOutput1(&fault))) {
+                fprintf(stderr, "[d3d12]   page fault address 0x%llX\n", (unsigned long long)(fault.PageFaultVA));
+                int shown = 0;
+                for (const D3D12_DRED_ALLOCATION_NODE1 *node = fault.pHeadExistingAllocationNode; (node != nullptr) && (shown < 16); node = node->pNext, shown++) {
+                    fprintf(stderr, "[d3d12]     existing \"%ls\" type %d\n", node->ObjectNameW ? node->ObjectNameW : L"", int(node->AllocationType));
+                }
+
+                for (const D3D12_DRED_ALLOCATION_NODE1 *node = fault.pHeadRecentFreedAllocationNode; (node != nullptr) && (shown < 32); node = node->pNext, shown++) {
+                    fprintf(stderr, "[d3d12]     freed \"%ls\" type %d\n", node->ObjectNameW ? node->ObjectNameW : L"", int(node->AllocationType));
+                }
+            }
+
+            dred->Release();
+        }
+
+        fflush(stderr);
+    }
