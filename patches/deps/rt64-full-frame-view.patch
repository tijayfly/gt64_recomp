+        cardBox[0].store(x0);
+        cardBox[1].store(y0);
+        cardBox[2].store(x1);
+        cardBox[3].store(y1);
+    }
+
+    double cardRemapScaleX() {
+        return double(cardBox[2].load() - cardBox[0].load()) / 320.0;
+    }
+
