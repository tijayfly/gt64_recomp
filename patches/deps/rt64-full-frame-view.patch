     // VI
     
+    // Output zoom around the centre of the picture, set by the game (GT64 shows its 4:3 screens inside a 16-line border:
+    // zooming by 240/208 makes them fill the screen's height). 1 = off.
+    static std::atomic<float> viZoom{ 1.0f };
+
+    // Set by the game while its 3D view fills the whole frame (GT64 single view), read by the S2DEX background and fade
+    // code to draw out to the screen's edges.
+    static std::atomic<bool> fullFrameView{ false };
+
+    void setFullFrameView(bool enabled) {
+        fullFrameView.store(enabled);
+    }
+
+    bool isFullFrameView() {
+        return fullFrameView.load();
+    }
+
+    void setVIZoom(float zoom) {
+        viZoom.store(std::max(zoom, 1.0f));
+    }
+
     hlslpp::float4 VI::viewRectangle() const {
-        return { 0.0f, 0.0f, 1.0f, 1.0f };
+        const float k = viZoom.load();
+        return { 0.5f - 0.5f * k, 0.5f - 0.5f * k, k, k };
     }
 
     hlslpp::float4 VI::cropRectangle() const {
-        return { 0.0f, 0.0f, 1.0f, 1.0f };
+        const float k = viZoom.load();
+        return { 0.5f - 0.5f * k, 0.0f, k, 1.0f };
     }
 
