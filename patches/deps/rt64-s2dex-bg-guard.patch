             }
         }
 
+        // A background object read from a stale display list (GT64 submits one leaving a race after it has reused that
+        // memory) can have zero or out-of-range sizes that divide by zero or never finish below: such objects are skipped.
+        static bool bgObjectValid(uint16_t imageW, uint16_t imageH, uint16_t frameW, uint16_t frameH, uint8_t imageSiz) {
+            const bool valid = (imageW >= 4) && (imageW < 0x1000) && (imageH >= 4) && (imageH < 0x1000) && (frameW >= 4) && (frameH >= 4) && (imageSiz <= G_IM_SIZ_32b);
+            if (!valid) {
+                static int logged = 0;
+                if (logged++ < 10) {
+                    fprintf(stderr, "[rt64] background object skipped: image %ux%u frame %ux%u size %u\n", imageW, imageH, frameW, frameH, imageSiz);
+                }
+            }
+            return valid;
+        }
+
         void bg1Cyc(State *state, DisplayList **dl) {
 #       ifdef LOG_BGRECT_METHODS
             RT64_LOG_PRINTF("bg1Cyc::start(0x%08X)", (*dl)->w1);
